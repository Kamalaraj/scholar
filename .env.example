# Copy to .env and fill in real values. Never commit .env.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://scholar:scholar@localhost:5434/scholar
GROQ_API_KEY=
# Optional: several keys (comma-separated) are rotated and used as rate-limit fallbacks
GROQ_API_KEYS=
TAVILY_API_KEY=
LLM_PROVIDER=groq
SEARCH_PROVIDER=tavily
# Groq model ids (override if Groq retires a model)
GROQ_STRONG_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Per-run limits
RUN_TOKEN_BUDGET=150000
RUN_TIMEOUT_SECONDS=600
MAX_RESEARCH_CONCURRENCY=3
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
FRONTEND_ORIGIN=http://localhost:3000
DAILY_RUN_LIMIT=5
# Langfuse tracing (optional): leave keys empty to turn it off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=

# --- Frontend ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# OpenRouter (optional last-resort fallback, free models)
OPENROUTER_API_KEY=
